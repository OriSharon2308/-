# מפתח API אחד לכל 4 הסוכנים — לא צריך מפתח לכל סוכן!

# --- Claude (מומלץ) ---
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# --- או OpenAI ---
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

SAFE_CHILD_MODE=true
# PORT=8787

# --- Azure Speech — כיום גיבוי בלבד (STT + TTS) ---
# שני השירותים עברו לגוגל. Azure נשאר כרשת-ביטחון אוטומטית אם גוגל נופל.
# הערה: מפתח Azure יכול לפוג בשקט ולהחזיר 401 — זה בדיוק מה שהשבית את
# השיחה הקולית ביולי 2026. גוגל משתמש באותן הרשאות של הקול, בלי מפתח נפרד.
AZURE_SPEECH_KEY=...
AZURE_SPEECH_REGION=eastus

# --- ספק STT: אוטומטי (גוגל אם יש GCP_PROJECT), או כפייה ידנית ---
# STT_PROVIDER=google   # או azure
# GCP_STT_MODEL=chirp_2            # chirp_2 קיים רק במיקומים מסוימים, לא ב-global
# GCP_STT_LOCATION=us-central1
# GCP_STT_MIN_CONFIDENCE=0.5       # מתחת לזה נחשב "לא שמעתי" — chirp_2 ממציא
#                                  # משפטים מרעש-רקע בביטחון ~0.17, מול 0.93+ לדיבור.
# דורש שירות מודלק בפרויקט:  gcloud services enable speech.googleapis.com

# ניקוד עברי (Dicta) — כבוי כברירת מחדל; יאומת בשלב שלו
NIKUD_ENABLED=false

# קול TTS (אופציונלי) — ברירת מחדל Hila HD. להשוואת קול גברי:
# AZURE_TTS_VOICE=he-IL-Avri:DragonHDOmniLatestNeural

# --- ספק TTS: azure (ברירת מחדל) או google (Gemini/Orus דרך Vertex AI + ADC) ---
TTS_PROVIDER=google
# Google Cloud (TTS דרך Vertex; אימות ADC עם gcloud — בלי קובץ מפתח בפרויקט)
GCP_PROJECT=your-project-id
GCP_LOCATION=us-central1
GOOGLE_TTS_VOICE=Orus
# בענן (Render, בלי gcloud): הדבק תוכן JSON של אישורי גוגל באחד מאלה:
# GCP_SA_KEY (ה-JSON עצמו) / GCP_SA_KEY_B64 / GOOGLE_APPLICATION_CREDENTIALS (נתיב לקובץ)
# עובד עם שני סוגים: מפתח חשבון-שירות, או הקובץ מהמחשב
# ~/.config/gcloud/application_default_credentials.json (נוצר ע"י gcloud auth application-default login)
# GCP_SA_KEY={"type":"service_account",...}  או  {"type":"authorized_user",...}

# Persistence בפרודקשן (Render): חבר Persistent Disk (למשל ב-/var/data) והגדר:
# DATA_DIR=/var/data
# בלעדיו כל deploy מוחק את data/ — חשבונות, פרופילים, פנקס-שיעורים ושיטות-לימוד.
